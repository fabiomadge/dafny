+namespace {
+// CVC5_LAZY_AXIOMS: a quantified input assertion whose every pattern is a list of
+// applications of uninterpreted functions can wait until its patterns can match.
+bool lazyAxiomsEnabled()
+{
+  static const bool on = std::getenv("CVC5_LAZY_AXIOMS") != nullptr;
+  return on;
+}
+bool isLazyAxiomCandidate(const Node& f)
+{
+  if (f.getKind() != Kind::FORALL || f.getNumChildren() != 3)
+  {
+    return false;
+  }
+  // only quantifiers over uninterpreted sorts: other strategies (such as
+  // counterexample-guided instantiation over arithmetic) instantiate the others
+  // without a trigger match, so those must not wait for one
+  static const bool anySort = std::getenv("CVC5_LAZY_ANY_SORT") != nullptr;
+  for (const Node& v : f[0])
+  {
+    if (!anySort && !v.getType().isUninterpretedSort())
+    {
+      return false;
+    }
+  }
+  bool hasPattern = false;
+  for (const Node& p : f[2])
+  {
+    if (p.getKind() != Kind::INST_PATTERN)
+    {
+      continue;
+    }
+    hasPattern = true;
+    for (const Node& t : p)
+    {
+      if (t.getKind() != Kind::APPLY_UF)
+      {
+        return false;
+      }
+    }
+  }
+  return hasPattern;
+}
+// debugging: CVC5_LAZY_AXIOMS_EXEMPT=a-b never holds back the candidates
+// numbered a to b-1 (in assertion order)
+bool lazyAxiomExempt()
+{
+  static long count = 0;
+  static const char* ex = std::getenv("CVC5_LAZY_AXIOMS_EXEMPT");
+  long n = count++;
+  if (ex == nullptr)
+  {
+    return false;
+  }
+  long a = std::strtol(ex, nullptr, 10);
+  const char* dash = std::strchr(ex, '-');
+  long b = dash != nullptr ? std::strtol(dash + 1, nullptr, 10) : a + 1;
+  return a <= n && n < b;
+}
