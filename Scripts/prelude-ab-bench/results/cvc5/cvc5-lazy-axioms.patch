+
+bool QuantifiersEngine::releaseAllLazyAxioms()
+{
+  size_t sent = 0;
+  for (const Node& q : d_env.getLazyAxioms())
+  {
+    if (d_lazyActive.find(q) == d_lazyActive.end())
+    {
+      d_lazyActive.insert(q);
+      d_qim.lemma(d_env.getTopLevelSubstitutions().apply(q),
+                  InferenceId::QUANTIFIERS_LAZY_AXIOM);
+      sent++;
+    }
+  }
+  if (sent > 0 && std::getenv("CVC5_LAZY_AXIOMS_DEBUG") != nullptr)
+  {
+    std::fprintf(stderr, "lazy: released the remaining %zu before answering\n", sent);
+  }
+  return sent > 0;
+}
+
+bool QuantifiersEngine::lazyPatternTermReady(
+    const Node& t, const Node& op, std::map<Node, std::unordered_set<Node>>& reps)
+{
+  TermDb* tdb = d_treg.getTermDatabase();
+  eq::EqualityEngine* ee = d_qstate.getEqualityEngine();
+  auto repsOf = [&](const Node& f) -> const std::unordered_set<Node>& {
+    auto it = reps.find(f);
+    if (it != reps.end())
+    {
+      return it->second;
+    }
+    std::unordered_set<Node>& r = reps[f];
+    for (size_t i = 0, n = tdb->getNumGroundTerms(f); i < n; i++)
+    {
+      Node g = tdb->getGroundTerm(f, i);
+      if (ee->hasTerm(g))
+      {
+        r.insert(ee->getRepresentative(g));
+      }
+    }
+    return r;
+  };
+  for (size_t i = 0, n = tdb->getNumGroundTerms(op); i < n; i++)
+  {
+    Node g = tdb->getGroundTerm(op, i);
+    if (g.getNumChildren() != t.getNumChildren())
+    {
+      continue;
+    }
+    bool ok = true;
+    for (size_t j = 0, m = t.getNumChildren(); ok && j < m; j++)
+    {
+      const Node& pa = t[j];
+      const Node& ga = g[j];
+      if (pa.getKind() == Kind::BOUND_VARIABLE)
+      {
+        continue;
+      }
+      if (pa.getKind() == Kind::APPLY_UF)
+      {
+        Node h = tdb->getMatchOperator(pa);
+        if (h.isNull())
+        {
+          continue;
+        }
+        const std::unordered_set<Node>& r = repsOf(h);
+        ok = ee->hasTerm(ga) && r.find(ee->getRepresentative(ga)) != r.end();
+      }
+      else if (!expr::hasBoundVar(pa))
+      {
+        ok = ee->hasTerm(pa) && ee->hasTerm(ga)
+             && ee->getRepresentative(pa) == ee->getRepresentative(ga);
+      }
+    }
+    if (ok)
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool QuantifiersEngine::activateLazyAxioms(Theory::Effort e)
+{
+  std::vector<Node>& lazy = d_env.getLazyAxioms();
+  if (lazy.empty())
+  {
+    return false;
+  }
+  // fairness: after this many full-effort checks, release whatever is still
+  // held back, so that a search that needs it does not run on without it
+  static const char* rounds = std::getenv("CVC5_LAZY_AXIOMS_ROUNDS");
+  static const size_t maxRounds =
+      rounds != nullptr ? std::strtoul(rounds, nullptr, 10) : 20;
+  if (++d_lazyChecks > maxRounds)
+  {
+    return releaseAllLazyAxioms();
+  }
+  TermDb* tdb = d_treg.getTermDatabase();
+  std::vector<Node> fire;
+  static const char* mode = std::getenv("CVC5_LAZY_AXIOMS");
+  // one level of matching for the first rounds (mode 2), then only the
+  // operators: an axiom some other strategy needs must not wait forever
+  const bool deep = mode != nullptr && mode[0] == '2' && d_lazyRounds++ < 8;
+  // representatives of the classes of each function's ground terms, computed on demand for this call
+  std::map<Node, std::unordered_set<Node>> reps;
+  for (const Node& q : lazy)
+  {
+    if (d_lazyActive.find(q) != d_lazyActive.end())
+    {
+      continue;
+    }
+    bool ready = false;
+    for (const Node& p : q[2])
+    {
+      if (p.getKind() != Kind::INST_PATTERN)
+      {
+        continue;
+      }
+      bool all = true;
+      for (const Node& t : p)
+      {
+        Node op = tdb->getMatchOperator(t);
+        if (op.isNull() || tdb->getNumGroundTerms(op) == 0
+            || (deep && !lazyPatternTermReady(t, op, reps)))
+        {
+          all = false;
+          break;
+        }
+      }
+      if (all)
+      {
+        ready = true;
+        break;
+      }
+    }
+    if (ready)
+    {
+      fire.push_back(q);
+    }
+  }
+  if (std::getenv("CVC5_LAZY_AXIOMS_DEBUG") != nullptr)
+  {
+    size_t active = 0;
+    for (const Node& q : lazy)
+    {
+      active += d_lazyActive.find(q) != d_lazyActive.end() ? 1 : 0;
+    }
+    std::fprintf(stderr, "lazy: effort %d release %zu (%s) active %zu of %zu\n",
+                 static_cast<int>(e), fire.size(),
+                 "ready",
+                 active, lazy.size());
+  }
+  if (fire.empty())
+  {
+    return false;
+  }
+  for (const Node& q : fire)
+  {
+    d_lazyActive.insert(q);
+    d_qim.lemma(d_env.getTopLevelSubstitutions().apply(q),
+                InferenceId::QUANTIFIERS_LAZY_AXIOM);
+  }
+  return true;
 }
 
