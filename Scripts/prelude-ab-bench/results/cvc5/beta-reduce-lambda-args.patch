+/// <summary>
+/// A method call's precondition, when Dafny checks it before the call rather than Boogie at the call.
+/// </summary>
+public class CallPreconditionSatisfied : ProofObligationDescriptionCustomMessages {
+  public override string DefaultSuccessDescription =>
+    "the precondition always holds";
+
+  public override string DefaultFailureDescription =>
+    "a precondition for this call could not be proved";
+
+  public override string ShortDescription => "call precondition";
+
+  private readonly Expression expr;
+
+  public CallPreconditionSatisfied(Expression expr, [CanBeNull] string customErrMsg, [CanBeNull] string customSuccessMsg)
+    : base(customErrMsg, customSuccessMsg) {
+    this.expr = expr;
+  }
+
+  public override Expression GetAssertedExpr(DafnyOptions options) {
+    return expr;
+  }
