+  /// <summary>
+  /// For a call to a non-generic lemma without out-parameters that passes a lambda literal without a precondition or a
+  /// reads clause, returns a substituter that replaces each such formal by its lambda and every other formal by
+  /// "substMap"'s local, and that beta-reduces the lambda's applications. Otherwise, returns null.
+  /// </summary>
+  Substituter BetaReducingCallSubstituter(MethodOrConstructor callee, bool isCoCall, Label atLabel, Dictionary<TypeParameter, Type> tySubst,
+    Dictionary<IVariable, Expression> directSubstMap, Dictionary<IVariable, Expression> substMap, Expression receiver) {
+    if (Environment.GetEnvironmentVariable("DAFNY_BETA_LAMBDA_ARGS") != "1" ||
+        callee is not Lemma || isCoCall || atLabel != null || callee.Outs.Count != 0 || tySubst.Count != 0) {
+      return null;
+    }
+    var map = new Dictionary<IVariable, Expression>();
+    var anyLambda = false;
+    foreach (var formal in callee.Ins) {
+      if (directSubstMap[formal].Resolved is LambdaExpr lambda && IsBetaReducible(lambda)) {
+        map.Add(formal, lambda);
+        anyLambda = true;
+      } else {
+        map.Add(formal, substMap[formal]);
+      }
+    }
+    return anyLambda ? new BetaReducingSubstituter(receiver, map) : null;
+  }
+
+  static bool IsBetaReducible(LambdaExpr lambda) {
+    return lambda.Range == null && lambda.Reads.Expressions is not { Count: > 0 };
+  }
+
+  static bool MentionsTwoStates(Expression expr) {
+    return expr is OldExpr or UnchangedExpr or FreshExpr || expr.SubExpressions.Any(MentionsTwoStates);
+  }
+
+  /// <summary>
+  /// A substituter that also replaces each application of a lambda without a precondition or a reads clause by the
+  /// lambda's body, with the arguments substituted for its parameters. A trigger that mentions a formal replaced by
+  /// a lambda is dropped, since its reduced form need not be a trigger.
+  /// </summary>
+  class BetaReducingSubstituter : Substituter {
+    private readonly HashSet<IVariable> lambdaFormals;
+
+    public BetaReducingSubstituter(Expression receiverReplacement, Dictionary<IVariable, Expression> substMap)
+      : base(receiverReplacement, substMap, new Dictionary<TypeParameter, Type>()) {
+      lambdaFormals = substMap.Where(kv => kv.Value is LambdaExpr).Select(kv => kv.Key).ToHashSet();
+    }
+
+    public override Expression Substitute(Expression expr) {
+      var e = base.Substitute(expr);
+      if (e is ApplyExpr app && app.Function.Resolved is LambdaExpr lambda && IsBetaReducible(lambda) &&
+          lambda.BoundVars.Count == app.Args.Count) {
+        var map = new Dictionary<IVariable, Expression>();
+        for (var i = 0; i < app.Args.Count; i++) {
+          map.Add(lambda.BoundVars[i], app.Args[i]);
+        }
+        return new Substituter(null, map, new Dictionary<TypeParameter, Type>()).Substitute(lambda.Body);
+      }
+      if (expr is QuantifierExpr { SplitQuantifier: null } original && e is QuantifierExpr result && result != original) {
+        result.Attributes = DropLambdaTriggers(original.Attributes, result.Attributes);
+      }
+      return e;
+    }
+
+    /// <summary>
+    /// "substituted" is "original" after substitution, node for node; drop the triggers whose original terms
+    /// mention a formal that is replaced by a lambda.
+    /// </summary>
+    private Attributes DropLambdaTriggers(Attributes original, Attributes substituted) {
+      if (original == null) {
+        return null;
+      }
+      var prev = DropLambdaTriggers(original.Prev, substituted.Prev);
+      if (original.Name == "trigger" && original.Args.Any(MentionsLambdaFormal)) {
+        return prev;
+      }
+      return prev == substituted.Prev ? substituted : new Attributes(substituted.Name, substituted.Args, prev);
+    }
+
+    private bool MentionsLambdaFormal(Expression expr) {
+      return expr is IdentifierExpr { Var: var v } && lambdaFormals.Contains(v) || expr.SubExpressions.Any(MentionsLambdaFormal);
+    }
+  }
